# ZhihuFlow local email delivery config.
# Copy this file to .env and fill ZHIHUFLOW_SMTP_PASSWORD with your QQ Mail authorization code.

ZHIHUFLOW_EMAIL_FROM=xxxxx@qq.com
ZHIHUFLOW_EMAIL_TO=xxxxx@qq.com
ZHIHUFLOW_SMTP_USER=xxxxx@qq.com
ZHIHUFLOW_SMTP_PASSWORD=replace_with_qq_mail_authorization_code
ZHIHUFLOW_SMTP_HOST=smtp.qq.com
ZHIHUFLOW_SMTP_PORT=465
