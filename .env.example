# RedFlow local email delivery config.
# Copy this file to .env and fill REDFLOW_SMTP_PASSWORD with your QQ Mail authorization code.

REDFLOW_EMAIL_FROM=xxxxx@qq.com
REDFLOW_EMAIL_TO=xxxxx@qq.com
REDFLOW_SMTP_USER=xxxxx@qq.com
REDFLOW_SMTP_PASSWORD=replace_with_qq_mail_authorization_code
REDFLOW_SMTP_HOST=smtp.qq.com
REDFLOW_SMTP_PORT=465
